# All values are 1Password secret references (op://vault/item/field), never real
# secrets. Run everything via:
#
#   op run --env-file=.env -- python orchestrator.py
#
# 1Password injects real values into that subprocess's environment only — nothing
# plaintext ever touches disk. See docs/SETUP.md for vault/item setup.

ANTHROPIC_API_KEY=op://ai-soc-copilot/anthropic/api_key

# VirusTotal — hash reputation lookups during enrichment (free tier: 4/min).
# Optional: the pipeline degrades to "reputation unavailable" if unset.
VT_API_KEY=op://ai-soc-copilot/virustotal/api_key

# Slack app running in Socket Mode — no public inbound endpoint required.
SLACK_BOT_TOKEN=op://ai-soc-copilot/slack/bot_token
SLACK_APP_TOKEN=op://ai-soc-copilot/slack/app_token
SLACK_SIGNING_SECRET=op://ai-soc-copilot/slack/signing_secret
# Channel the bot posts approvals to (NOT a secret — plain value; the bot must be
# invited to it). Use the channel name (#soc-alerts) or its ID (C0123ABCD).
SLACK_CHANNEL=#soc-alerts

# Wazuh manager API (port 55000) — used for active-response / agent queries.
WAZUH_API_URL=https://localhost:55000        # via SSH tunnel (scripts/tunnel.sh)
WAZUH_API_USER=op://ai-soc-copilot/wazuh/api_user
WAZUH_API_PASSWORD=op://ai-soc-copilot/wazuh/api_password

# Wazuh indexer (OpenSearch, port 9200) — used to query wazuh-alerts-* index.
WAZUH_INDEXER_URL=https://localhost:9200    # via SSH tunnel (scripts/tunnel.sh)
WAZUH_INDEXER_USER=op://ai-soc-copilot/wazuh/indexer_user
WAZUH_INDEXER_PASSWORD=op://ai-soc-copilot/wazuh/indexer_password

# Hetzner API token — only needed for `terraform apply` in infra/hetzner, not
# by the Python pipeline. Terraform reads TF_VAR_<name> as variable "<name>".
TF_VAR_hcloud_token=op://ai-soc-copilot/hetzner/api_token

# Optional: link cases to your Wazuh dashboard from the UI (plain value, not a secret)
# WAZUH_DASHBOARD_URL=https://<your-wazuh-host>
