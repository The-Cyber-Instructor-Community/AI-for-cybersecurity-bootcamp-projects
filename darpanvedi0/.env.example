# Copy to .env and fill in. Never commit .env.
# The LangFlow agents the Console runs (without them it uses the mock writer):
#   LANGFLOW_URL       LangFlow's address
#   LANGFLOW_FLOW_ID   the Chimera flow's ID (in LangFlow: the flow's API access panel, /api/v1/run/<flow id>)
#   LANGFLOW_API_KEY   a LangFlow API key (LangFlow: Settings -> API Keys)
LANGFLOW_URL=http://127.0.0.1:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
# Only for A3 web leads (chimera/leads.py, Claude with web search), when the applicant consented:
ANTHROPIC_API_KEY=
